# Jira Cloud email and API token: https://id.atlassian.com/manage-profile/security/api-tokens
REPORT_PROJECT_NAME=Example Project
JIRA_PROJECT_KEY=EXAMPLE
JIRA_PROJECT_TIMEZONE=America/New_York
JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=reporting-bot@example.com
JIRA_API_TOKEN=replace_with_a_secret_from_your_environment
JIRA_JQL=project = EXAMPLE ORDER BY updated DESC
# Set this to the custom field key used for story points, or leave blank to omit it.
JIRA_STORY_POINTS_FIELD=customfield_10016

# Status mappings are Status=Category; the four approved mappings are required.
REPORT_STATUS_MAPPINGS=To Do=Planned,In Progress=Active,Blocked=Blocked,Done=Completed
REPORT_BLOCKED_LABELS=blocked
REPORT_AT_RISK_LABELS=at-risk,risk
REPORT_AT_RISK_PRIORITIES=Highest,High
REPORT_DUE_SOON_DAYS=7
REPORT_HEALTH_GREEN_MAX_PERCENT=10
REPORT_HEALTH_YELLOW_MAX_PERCENT=20
REPORT_DETAIL_LIMIT=100

# PostgreSQL metadata/audit storage. Inject real credentials via the deployment environment.
DATABASE_URL=postgresql://status_reporter:replace_me@localhost:5432/status_reporter
AUDIT_RETENTION_DAYS=90

# SMTP credentials should be injected by the deployment environment, not committed here.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_MAX_RETRIES=3
SMTP_SENDER=status-reports@example.com
SMTP_RECIPIENTS=leadership@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
